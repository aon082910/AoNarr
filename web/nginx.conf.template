server {
    listen 9876;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # script-src is strict (no unsafe-inline/eval) since the app is plain React with no inline
    # scripts (theme-init.js is a real file, see index.html) and no known dangerouslySetInnerHTML
    # use. style-src needs unsafe-inline because React's `style={{...}}` renders as inline style
    # attributes throughout the app — removing that would mean rewriting every styled component to
    # CSS classes, well beyond what this header is trying to fix. img-src stays wide open (any
    # https/http origin, data:, blob:) since posters/backdrops/media-server artwork can come from
    # any URL an admin configures — same reasoning as crossOriginResourcePolicy:false on the API
    # server (see server/src/app.ts). frame-ancestors is deliberately NOT restricted: this app is
    # commonly embedded in dashboard tools (Organizr, Homarr, Heimdall) and had no framing
    # restriction before this header existed either.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'" always;

    location /api/ {
        proxy_pass http://${AONARR_SERVER_HOST}:${AONARR_SERVER_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        # nginx's 1m default would reject a large settings-template import (the API accepts 10mb)
        # or a CSV/avatar upload with its own HTML 413 before the request ever reaches the server.
        client_max_body_size 10m;
        # A handful of endpoints (large-file recycle/import operations, bulk exports) can
        # legitimately run past nginx's 60s defaults — that's a slow-but-alive backend and should
        # surface as a real timeout (504), not the ambiguous "connection just dropped" a client
        # sees once the browser/any intermediate proxy gives up first.
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri /index.html;
    }

    # Vite's built JS/CSS filenames are content-hashed (index-<hash>.js) — a new build always gets a
    # new filename, so these are safe to cache forever. index.html is the opposite: it's the one file
    # that references those hashed names, so it must never be cached, or the browser can keep serving
    # a stale index.html pointing at JS that predates whatever update was just deployed — this was
    # the actual cause of "the UI still looks the same after updating the container."
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Browsers already re-check a registered service worker's script at most once every 24h by
    # spec regardless of headers — this just makes sure that check, whenever it happens, isn't
    # itself served from a stale HTTP cache.
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
